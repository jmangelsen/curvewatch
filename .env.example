# ---------- Curvewatch configuration ----------
# Copy to .env and fill in. Everything except the Telegram pair is optional.

PORT=8080
DATA_DIR=./data
TZ_NAME=America/Denver

# Dashboard protection (HTTP basic auth; any username, this password). STRONGLY recommended on a VPS.
DASHBOARD_PASSWORD=

# Telegram: create a bot with @BotFather (/newbot), open the bot and send /start, then run
#   TELEGRAM_BOT_TOKEN=<token> npm run tg-setup
# to print your numeric chat id. A @username alone is not enough: bots cannot message you first.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# all = every alert + strong signals | strong = strong signals + system messages only | off
TELEGRAM_MODE=strong
# optional: send strong signals to a different chat than system messages
TELEGRAM_STRONG_CHAT_ID=
DAILY_SUMMARY_HOUR=8

# Dead-man switch: free check at https://healthchecks.io -> paste the ping URL. You get emailed if pings stop.
HEALTHCHECK_URL=

# ---------- Data sources ----------
# rpc = decode every Pump.fun trade from Solana program logs (recommended; includes slots for bundle detection)
# pumpportal = per-token metered trade subscriptions (needs PUMPPORTAL_API_KEY + funded wallet; no slot data)
TRADE_SOURCE=rpc
# Comma-separated; rotated on failure. Public RPC works but is rate-limited and not meant for production.
# For 24/7 use a paid RPC websocket first, public as fallback, e.g.:
# RPC_WS_URLS=wss://mainnet.helius-rpc.com/?api-key=XXXX,wss://api.mainnet-beta.solana.com
RPC_WS_URLS=wss://api.mainnet-beta.solana.com
PUMPPORTAL_API_KEY=

# ---------- Scoring (priors: recalibrate with `npm run backtest`) ----------
ALERT_SCORE=72
ALERT_MIN_AGE_SEC=45
ALERT_MAX_AGE_SEC=900
MIN_UNIQUE_BUYERS=15
MAX_TOP10_PCT=45
MAX_BUNDLE_PCT=55
MAX_CREATOR_SOLD_PCT=50
MAX_CURVE_PROGRESS_PCT=88
SERIAL_RUGGER_LAUNCHES=8

# ---------- Paper trading / kill rule ----------
PAPER_SIZE_SOL=0.2
PAPER_ENTRY_DELAY_SEC=15
PAPER_EXTRA_SLIPPAGE_PCT=3
# v2 exits: sell everything at +25% net, stop at -20% net (net = after fees and slippage)
PAPER_RULES=v2
PAPER_TP1_MULT=1.25
PAPER_TP1_FRACTION=1
PAPER_TRAIL_PCT=35
PAPER_STOP_PCT=20
PAPER_MAX_HOLD_MIN=60
KILL_MIN_TRADES=50

# ---- Graduates (post-migration re-ignition board) ----
GRAD_ENABLED=true
GRAD_POLL_SEC=60
GRAD_MAX_WATCH=900
GRAD_MIN_AGE_MIN=20
GRAD_MAX_AGE_H=72
GRAD_MIN_LIQ_USD=12000
GRAD_DEAD_LIQ_USD=4000
GRAD_COLLAPSED_FRAC=0.2
GRAD_ALERT_SCORE=70
GRAD_ALERT_COOLDOWN_MIN=120
GRAD_SEED_DEX=true
GRAD_SNAPSHOT_MIN=10
GRAD_PAPER_ENABLED=true
GRAD_PAPER_SIZE_SOL=0.2
GRAD_PAPER_FEE_PCT=1.0
GRAD_PAPER_EXTRA_SLIPPAGE_PCT=2
GRAD_PAPER_TP1_MULT=1.5
GRAD_PAPER_TP1_FRACTION=0.5
GRAD_PAPER_TRAIL_PCT=25
GRAD_PAPER_STOP_PCT=30
GRAD_PAPER_MAX_HOLD_MIN=360

# ---- Strong signals (the Telegram tier) ----
# Fires when similar historical setups reached +TARGET% net before -STOP% at least MIN_HIT% of the time
# over MIN_SAMPLES+ cases. Before that history exists, only score >= FALLBACK fires, labeled UNCALIBRATED.
STRONG_ENABLED=true
STRONG_TARGET_PCT=25
STRONG_STOP_PCT=20
STRONG_MIN_HIT_PCT=45
STRONG_MIN_SAMPLES=30
STRONG_SCORE_BAND=6
STRONG_FALLBACK_CURVE_SCORE=85
STRONG_FALLBACK_GRAD_SCORE=82
STRONG_MAX_PER_HOUR=4
STRONG_LOOKBACK_DAYS=30

# ---- Parallel paper book: enters when a score first lands in [BAND_LO, BAND_HI) ----
BAND_ENABLED=true
BAND_LO=65
BAND_HI=72

# ---- Market conditions: rolling win rate of the last N closed paper trades ----
# shadow = tag and measure only (default) | enforce = pause strong signals and exclude paused entries from the kill rule
MARKET_GATE_MODE=shadow
MARKET_GATE_WINDOW=20
MARKET_GATE_MIN_TRADES=10
MARKET_GATE_PAUSE_BELOW=30
MARKET_GATE_RESUME_AT=35
MARKET_GATE_LOOKBACK_H=6

# ---- Strategy lab (paper only). Each book runs in parallel and is judged by the same kill rule. ----
# Flow: real money arriving. Cutoffs from the October 14, 2026 calibration (terciles of labeled snapshots).
FLOW_ENABLED=true
FLOW_MIN_SCORE=50
FLOW_MIN_FLOW60_SOL=12.6
FLOW_MIN_MEDIAN_BUY_SOL=0.387
# Confirm: on a main/band signal, wait, enter only if price held, take a closer target.
CONFIRM_ENABLED=true
CONFIRM_WAIT_SEC=60
CONFIRM_MIN_RET_PCT=0
CONFIRM_TP_GROSS_PCT=20
CONFIRM_STOP_NET_PCT=20

# ---- Retention ----
# Snapshots of rejected tokens no longer store feature vectors (they were 60%+ of the DB).
RETAIN_SNAPSHOTS_DAYS=30
RETAIN_TRADES_DAYS=14
RETAIN_WALLETS_DAYS=30
