# ---------- Curvewatch configuration ----------
# Copy to .env and fill in. Everything except the Telegram pair is optional.

PORT=8080
DATA_DIR=./data
TZ_NAME=America/Denver

# Dashboard protection (HTTP basic auth; any username, this password). STRONGLY recommended on a VPS.
DASHBOARD_PASSWORD=

# Telegram alerts: create a bot with @BotFather, then message it once and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_SUMMARY_HOUR=8

# Dead-man switch: free check at https://healthchecks.io -> paste the ping URL. You get emailed if pings stop.
HEALTHCHECK_URL=

# ---------- Data sources ----------
# rpc = decode every Pump.fun trade from Solana program logs (recommended; includes slots for bundle detection)
# pumpportal = per-token metered trade subscriptions (needs PUMPPORTAL_API_KEY + funded wallet; no slot data)
TRADE_SOURCE=rpc
# Comma-separated; rotated on failure. Public RPC works but is rate-limited and not meant for production.
# For 24/7 use a paid RPC websocket first, public as fallback, e.g.:
# RPC_WS_URLS=wss://mainnet.helius-rpc.com/?api-key=XXXX,wss://api.mainnet-beta.solana.com
RPC_WS_URLS=wss://api.mainnet-beta.solana.com
PUMPPORTAL_API_KEY=

# ---------- Scoring (priors: recalibrate with `npm run backtest`) ----------
ALERT_SCORE=72
ALERT_MIN_AGE_SEC=45
ALERT_MAX_AGE_SEC=900
MIN_UNIQUE_BUYERS=15
MAX_TOP10_PCT=45
MAX_BUNDLE_PCT=55
MAX_CREATOR_SOLD_PCT=50
MAX_CURVE_PROGRESS_PCT=88
SERIAL_RUGGER_LAUNCHES=8

# ---------- Paper trading / kill rule ----------
PAPER_SIZE_SOL=0.2
PAPER_ENTRY_DELAY_SEC=15
PAPER_EXTRA_SLIPPAGE_PCT=3
PAPER_TP1_MULT=2
PAPER_TP1_FRACTION=0.5
PAPER_TRAIL_PCT=35
PAPER_STOP_PCT=40
PAPER_MAX_HOLD_MIN=60
KILL_MIN_TRADES=50
