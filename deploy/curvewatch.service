# systemd alternative to Docker: /etc/systemd/system/curvewatch.service
[Unit]
Description=Curvewatch Pump.fun screener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=curvewatch
WorkingDirectory=/opt/curvewatch
ExecStart=/usr/bin/node --max-old-space-size=768 src/index.js
Restart=always
RestartSec=5
EnvironmentFile=/opt/curvewatch/.env
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/curvewatch/data

[Install]
WantedBy=multi-user.target
