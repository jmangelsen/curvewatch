# Curvewatch production environment (copied to /opt/curvewatch/.env by deploy/install-systemd.sh).
# Loaded by systemd's EnvironmentFile: no quotes, no `export`, one KEY=value per line. Full reference: .env.example
NODE_ENV=production
PORT=8080
DATA_DIR=/opt/curvewatch/data
BACKUP_DIR=/opt/curvewatch/backups
TZ_NAME=America/Denver

# Dashboard login (HTTP basic auth; any username + this password). The installer fills a random value.
DASHBOARD_PASSWORD=__GENERATED__

# Telegram (optional). Create a bot with @BotFather, send it /start, then `TELEGRAM_BOT_TOKEN=... npm run tg-setup` prints the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MODE=strong
DAILY_SUMMARY_HOUR=8

# Dead-man switch: free check at healthchecks.io -> paste the ping URL. You get emailed if the collector stops pinging.
HEALTHCHECK_URL=

# Data sources. Public RPC is rate-limited; for 24/7 use a paid websocket first, public as fallback, e.g.
# RPC_WS_URLS=wss://mainnet.helius-rpc.com/?api-key=XXXX,wss://api.mainnet-beta.solana.com
TRADE_SOURCE=rpc
RPC_WS_URLS=wss://api.mainnet-beta.solana.com
PUMPPORTAL_API_KEY=

# Retention (days). 30 days of curve snapshots is roughly 6-9 GB at current launch rates; size the disk accordingly.
RETAIN_SNAPSHOTS_DAYS=30
RETAIN_TRADES_DAYS=14
RETAIN_WALLETS_DAYS=30

# Everything else (scoring, paper books, graduates, Edge Lab) uses the defaults in .env.example. Override here if needed.

# Edge-lab worker: rolling window (days) and heap cap (MB). On a 2 GB droplet keep the window at 7; raise it on 4 GB.
EDGE_WINDOW_DAYS=7
EDGE_WORKER_HEAP_MB=1024
